---
import Base from '../layouts/Base.astro';
import { url } from '../consts';
---
<Base title="Page not found">
  <div slot="sky" class="container head">
    <h1>This chunk hasn't generated</h1>
    <p>There's no page at this address. It may have moved, or the link has a typo.</p>
    <a class="btn btn-primary" href={url()}>Go to the home page</a>
  </div>
</Base>

<style>
  .head {
    padding: 64px var(--gutter) 96px;
  }
  h1 {
    max-width: 14ch;
    font-size: clamp(44px, 7vw, 72px);
    font-weight: 700;
    color: var(--sky-fg);
    text-shadow: 4px 4px 0 var(--title-shadow);
  }
  p {
    margin: 16px 0 28px;
    font-size: 19px;
    color: var(--sky-fg-soft);
  }
</style>
