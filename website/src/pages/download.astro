---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import GitHubIcon from '../components/GitHubIcon.astro';
import { REPO_URL } from '../consts';
---
<Base title="Download" description="Download Bananium, or build it from source with Rust and Bun." ground="deepslate">
  <div slot="sky" class="container head">
    <h1>Get Bananium</h1>
    <p>Free and open source. Tested on Windows 11 and Linux (x86_64).</p>
  </div>

  <div class="container page">
    <section class="release" aria-labelledby="release-title">
      <h2 id="release-title">Installers</h2>
      <p class="soft">
        Prebuilt installers aren't published yet. They'll appear on the GitHub Releases page first;
        watch the repository to hear when they land. Until then, building from source takes a few
        minutes.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={`${REPO_URL}/releases`} rel="noopener">Open Releases</a>
        <a class="btn btn-stone" href={REPO_URL} rel="noopener"><GitHubIcon /> View source</a>
      </div>
    </section>

    <section id="build" aria-labelledby="build-title">
      <h2 id="build-title">Build from source</h2>
      <ol class="steps">
        <li>
          <h3>Install the tools</h3>
          <p class="soft">
            <a href="https://rustup.rs/" rel="noopener">Rust</a> (stable), <a href="https://bun.sh/" rel="noopener">Bun</a>, and the <a href="https://v2.tauri.app/start/prerequisites/" rel="noopener">Tauri 2 prerequisites</a> for your OS: WebView2 on Windows, WebKitGTK on Linux. You don't need Java; Bananium
            downloads the right runtime itself.
          </p>
        </li>
        <li>
          <h3>Get the code and run the app</h3>
          <Terminal
            lines={[
              `$ git clone ${REPO_URL}.git`,
              '$ cd Bananium/desktop',
              '$ bun install',
              '$ bun run tauri dev',
            ]}
          />
        </li>
        <li>
          <h3>Build an installer</h3>
          <p class="soft">From <code>desktop/</code>. The installer is written under <code>target/release/bundle/</code>.</p>
          <Terminal lines={['$ bun run tauri build']} />
        </li>
        <li>
          <h3>Build the command line tools</h3>
          <p class="soft">
            Optional. The desktop bundle has to be built first, because the workspace embeds it.
            This gives you <code>bananium</code> and <code>bananium-tui</code> in <code>target/release/</code>.
          </p>
          <Terminal
            lines={[
              '$ cd desktop && bun install && bun run build && cd ..',
              '$ cargo build --workspace --release',
            ]}
          />
        </li>
      </ol>
    </section>
  </div>
</Base>

<style>
  .head {
    padding: 48px var(--gutter) 72px;
  }
  h1 {
    font-size: clamp(48px, 7vw, 72px);
    font-weight: 700;
    color: var(--sky-fg);
    text-shadow: 4px 4px 0 var(--title-shadow);
  }
  .head p {
    margin-top: 16px;
    font-size: 19px;
    color: var(--sky-fg-soft);
  }
  .page {
    max-width: 820px;
    padding-top: 64px;
    padding-bottom: 96px;
  }
  h2 {
    font-size: 36px;
  }
  h3 {
    font-size: 21px;
    margin-bottom: 10px;
  }
  .release .soft {
    margin-top: 12px;
    max-width: var(--measure);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 24px;
  }
  #build {
    margin-top: 88px;
  }
  .steps {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    counter-reset: step;
    display: grid;
    gap: 40px;
  }
  .steps li {
    counter-increment: step;
    position: relative;
    padding-left: 56px;
  }
  /* Each step number sits on a small stone block. */
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: -2px;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    background: #3a3936;
    box-shadow: inset -4px -4px 0 rgba(0, 0, 0, 0.25), inset 4px 4px 0 rgba(255, 255, 255, 0.12);
    font: 700 18px/1 var(--font-display);
    color: #f7f7f5;
  }
  .steps .soft {
    max-width: var(--measure);
    margin-bottom: 16px;
  }
  code {
    padding: 1px 5px;
    border-radius: 3px;
    background: var(--well);
    color: var(--fg);
  }
  @media (max-width: 560px) {
    .steps li {
      padding-left: 0;
      padding-top: 48px;
    }
  }
</style>
