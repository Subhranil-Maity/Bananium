---
// A screenshot of the app. The captures already include the app's own title
// bar, so no frame is drawn around them.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  eager?: boolean;
  widths?: number[];
  sizes?: string;
  class?: string;
}
const {
  src,
  alt,
  eager = false,
  widths = [640, 960, 1440],
  sizes = '(max-width: 900px) 100vw, 640px',
  class: className,
} = Astro.props;
---
<Image
  class:list={['shot', className]}
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
/>

<style>
  .shot {
    width: 100%;
    height: auto;
    border-radius: 8px;
    /* A hard block shadow, like an item dropped on the ground. */
    box-shadow: 10px 10px 0 rgba(0, 0, 0, 0.5);
  }
</style>
