---
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { AUTHOR_HANDLE, AUTHOR_NAME, AUTHOR_URL, REPO_URL, url } from '../consts';
import { readingMinutes, type Post } from '../posts';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const editUrl = `${REPO_URL}/edit/main/website/${post.filePath}`;
---
<Base title={title} description={description} type="article" publishedTime={pubDate} ground="deepslate">
  <header slot="sky" class="container head">
    <a class="back" href={url('blog/')}>All posts</a>
    <h1>{title}</h1>
    <p class="desc">{description}</p>
    <p class="meta">
      By <a href={AUTHOR_URL} rel="author noopener">{AUTHOR_NAME}</a> (@{AUTHOR_HANDLE}) on <FormattedDate date={pubDate} />.{' '}
      {readingMinutes(post.body)} min read.
      {updatedDate && <span> Updated <FormattedDate date={updatedDate} />.</span>}
    </p>
  </header>

  <article class="container post">
    <div class="prose">
      <slot />
    </div>

    <footer>
      {tags.length > 0 && <p class="tags">Tagged {tags.join(', ')}</p>}
      <a href={editUrl} rel="noopener">Edit this post on GitHub</a>
    </footer>
  </article>
</Base>

<style>
  .head {
    max-width: 820px;
    padding-top: 40px;
    padding-bottom: 72px;
  }
  .back {
    font-weight: 600;
    font-size: 15px;
  }
  h1 {
    margin-top: 20px;
    font-size: clamp(40px, 6vw, 60px);
    font-weight: 700;
    color: var(--sky-fg);
    text-shadow: 3px 3px 0 var(--title-shadow);
  }
  .desc {
    margin-top: 16px;
    font-size: 19px;
    color: var(--sky-fg-soft);
    max-width: 56ch;
  }
  .meta {
    margin-top: 20px;
    font-size: 15px;
    color: var(--sky-fg-soft);
  }
  .post {
    max-width: 820px;
    padding-top: 56px;
    padding-bottom: 96px;
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 2px solid var(--rule);
    font-size: 15px;
  }
  .tags {
    color: var(--fg-soft);
  }

  /* Markdown body. */
  .prose {
    max-width: var(--measure);
    font-size: 18px;
    line-height: 1.7;
  }
  .prose :global(> * + *) {
    margin-top: 1.1em;
  }
  .prose :global(h2) {
    font-size: 30px;
    margin-top: 1.8em;
  }
  .prose :global(h3) {
    font-size: 23px;
    margin-top: 1.6em;
  }
  .prose :global(h2 + *),
  .prose :global(h3 + *) {
    margin-top: 0.6em;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3em;
  }
  .prose :global(li + li) {
    margin-top: 0.35em;
  }
  .prose :global(ul li::marker) {
    color: var(--banana);
  }
  .prose :global(blockquote) {
    margin-inline: 0;
    padding: 12px 18px;
    border-left: 6px solid var(--banana);
    background: var(--well);
    color: var(--fg-soft);
  }
  .prose :global(:not(pre) > code) {
    padding: 1px 5px;
    border-radius: 3px;
    background: var(--well);
    font-size: 0.85em;
  }
  .prose :global(pre) {
    padding: 18px 20px;
    border-radius: 6px;
    font-size: 15px;
    line-height: 1.65;
    overflow-x: auto;
    box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.3);
  }
  .prose :global(img) {
    border-radius: 6px;
    box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.3);
  }
  .prose :global(hr) {
    border: 0;
    border-top: 2px solid var(--rule);
    margin-block: 2.5em;
  }
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 16px;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 8px 12px;
    border-bottom: 2px solid var(--rule);
    text-align: left;
  }
</style>
